@page "/produce"
<h3>Produce Product</h3>
<br />
@attribute [Authorize(policy: Policies.Productions)]
@rendermode InteractiveServer
@inject IJSRuntime js;
@inject AuthenticationStateProvider authStateProvider;
@inject IViewProductsByNameUseCase viewUseCase;
@inject IGetProductByIdUseCase getByIdUseCase;
@inject IProduceProductUseCase produceUseCase;

<EditForm id="produce-form" Model="viewModel" OnValidSubmit="Produce">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group">
        <label for="po">Produce Order #</label>
        <InputText id="po" class="form-control" @bind-Value="viewModel.ProductionNumber" />
    </div>
    <br />
    <div class="form-group">
        <AutoCompleteComponent Label="Search Product to Produce" Placeholder="Start typing to search product..."
            SearchFunction="SearchProduct" OnItemSelected="OnProductSelected">
        </AutoCompleteComponent>
    </div>
    <br />
    <div class="form-group">
        <label for="qty">Quantity</label>
        <InputNumber id="qty" class="form-control" @bind-Value="viewModel.QuantityToProduce" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Produce</button>
</EditForm>


@code {
    private ProduceViewModel viewModel = new ProduceViewModel();
    private Product? selectedProduct = null;
    [PersistentState]
    public string? userName { get; private set; }

    protected override async Task OnInitializedAsync()
    {
        userName ??= (await authStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name;
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        OnAfterRender(firstRender);
        if (firstRender)
        {
            await js.InvokeVoidAsync("preventFormSubmitOnEnter", "produce-form");
        }
        // Example JSInterop usage (added in .NET 10): get document location and set document title
        var url = await js.GetValueAsync<string>("document.location.href");
        await js.InvokeVoidAsync("console.log", $"Window url from JSInterop: {url}");
        await js.SetValueAsync("document.title", "Produce Product - IMS");
    }

    private async Task Produce()
    {
        await produceUseCase.ExecuteAsync(viewModel.ProductionNumber, selectedProduct!, viewModel.QuantityToProduce, userName!);
        viewModel = new ProduceViewModel();
        selectedProduct = null;
    }

    private async Task<IList<ItemViewModel>> SearchProduct(string query)
    {
        return (await viewUseCase.ExecuteAsync(query))
        .Select(prod => new ItemViewModel { Id = prod.Id, Name = prod.Name })
        .ToList();
    }
    private async Task OnProductSelected(ItemViewModel item)
    {
        viewModel.ProductId = item.Id;
        selectedProduct = await getByIdUseCase.ExecuteAsync(item.Id);
        Console.WriteLine($"Selected Product: {selectedProduct?.Name}");
        viewModel.Product = selectedProduct;
    }
}