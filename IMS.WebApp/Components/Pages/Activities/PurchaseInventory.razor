@page "/purchase"
@using System.Threading.Tasks
@attribute [Authorize]
@rendermode InteractiveServer
@inject IJSRuntime js;
@inject IViewInventoriesByNameUseCase viewUseCase;
@inject IGetInventoryByIdUseCase GetByIdUseCase;
@inject IPurchaseInventoryUseCase PurchaseUseCase;
<h3>Purchase Inventory</h3>
<br />
<EditForm id="purchase-form" Model="viewModel" OnValidSubmit="Purchase">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group">
        <label for="po">Purchase Order #</label>
        <InputText id="po" class="form-control" @bind-Value="viewModel.PONumber" />
    </div>
    <br />
    <div class="card">
        <div class="card-body">
            <div class="form-group">
                <AutoCompleteComponent Label="Search Inventory to Purchase"
                    Placeholder="Start typing to search inventory..." SearchFunction="SearchInventory"
                    OnItemSelected="OnInventorySelected">
                </AutoCompleteComponent>
                @if (viewModel.InventoryId > 0)
                {
                    <p>Inventory Price: @viewModel.InventoryPrice.ToString("c")</p>
                }
            </div>
        </div>
    </div>
    <br />
    <div class="form-group">
        <label for="qty">Quantity</label>
        <InputNumber id="qty" class="form-control" @bind-Value="viewModel.QuantityToPurchase" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Purchase</button>
</EditForm>


@code {
    private PurchaseViewModel viewModel = new PurchaseViewModel();
    private Inventory? selectedInventory;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            js.InvokeVoidAsync("preventFormSubmitOnEnter", "purchase-form");
        }
    }

    private async Task<IList<ItemViewModel>> SearchInventory(string query)
    {
        return (await viewUseCase.ExecuteAsync(query))
        .Select(inv => new ItemViewModel { Id = inv.Id, Name = inv.Name })
        .ToList();
    }

    private async Task OnInventorySelected(ItemViewModel item)
    {
        // Write selected item to the console for demo purposes
        viewModel.InventoryId = item.Id;
        selectedInventory = await GetByIdUseCase.ExecuteAsync(item.Id);
        Console.WriteLine($"Selected Inventory: {selectedInventory?.Name}");
        viewModel.InventoryPrice = selectedInventory!.Price;
    }
    private async Task Purchase()
    {
        // !!! TODO: Replace "Alex" with logged in user
        await PurchaseUseCase.ExecuteAsync(viewModel.PONumber, selectedInventory!, viewModel.QuantityToPurchase, "Alex");
        viewModel = new PurchaseViewModel();
        selectedInventory = null;
    }
}