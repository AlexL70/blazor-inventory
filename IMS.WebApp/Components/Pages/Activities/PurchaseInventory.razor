@page "/purchase"
@using System.Threading.Tasks
@using static IMS.WebApp.Components.Controls.Common.AutoCompleteComponent
@rendermode InteractiveServer
@inject IViewInventoriesByNameUserCase viewUseCase;
<h3>Purchase Inventory</h3>
<br />
<AutoCompleteComponent Label="Search Inventory" Placeholder="Start typing to search inventory..."
    SearchFunction="SearchInventory" OnItemSelected="OnInventorySelected">
</AutoCompleteComponent>
@code {
    private List<ItemViewModel> SearchInventory(string query)
    {
        return viewUseCase.ExecuteAsync(query).GetAwaiter().GetResult()
        .Select(inv => new ItemViewModel { Id = inv.Id, Name = inv.Name })
        .ToList();
    }

    private void OnInventorySelected(ItemViewModel item)
    {
        // Write selected item to the console for demo purposes
        Console.WriteLine($"Selected Inventory Item: {item.Id} - {item.Name}");
    }
}