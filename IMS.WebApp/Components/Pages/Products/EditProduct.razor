@page "/products/edit/{Id:int}"
@using IMS.CoreBusiness.Exceptions
@attribute [Authorize(policy: Policies.Inventory)]
@rendermode InteractiveServer
@inject IGetProductByIdUseCase getByIdUseCase;
@inject IEditProductUseCase editUseCase;
@inject NavigationManager navManager;

<h3>Edit Product</h3>
<br />
@if (product is not null)
{
    <EditForm Model="product" OnValidSubmit="Update">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label for="name">Name:</label>
            <InputText id="name" class="form-control" @bind-Value="product.Name" />
            <ValidationMessage For="@(() => product.Name)" />
        </div>
        <div class="form-group">
            <label for="quantity">Quantity:</label>
            <InputNumber id="quantity" class="form-control" @bind-Value="product.Quantity" />
            <ValidationMessage For="@(() => product.Quantity)" />
        </div>
        <div class="form-group">
            <label for="price">Price:</label>
            <InputNumber id="price" class="form-control" @bind-Value="product.Price" />
            <ValidationMessage For="@(() => product.Price)" />
        </div>
        <div class="form-group">
            <label for="inventories">Inventories:</label>
            <ProductInventoriesComponent Product="product"></ProductInventoriesComponent>
        </div>
        <div class="form-group">
            <br />
            <button type="submit" class="btn btn-primary">Update</button>
            &nbsp;
            <a href="/products" class="btn btn-secondary">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Product? product { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            product = await getByIdUseCase.ExecuteAsync(Id);
        }
        catch (NotFoundException)
        {
            navManager.NotFound();
        }
    }

    private async Task Update()
    {
        await editUseCase.ExecuteAsync(product!);
        navManager.NavigateTo("/products");
    }
}