@page "/inventories/edit/{InventoryId:int}"
@using IMS.CoreBusiness.Exceptions
@attribute [Authorize]
@inject IGetInventoryByIdUseCase getUseCase
@inject IEditInventoryUseCase editUseCase;
@inject NavigationManager navManager

<h3>Edit Inventory</h3>
@if (inventory is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="inventory" FormName="formInventory" OnValidSubmit="Update">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <InputNumber @bind-Value="inventory.Id" hidden />
        <div class="form-group">
            <label for="name">Name:</label>
            <InputText id="name" class="form-control" @bind-Value="inventory.Name" />
            <ValidationMessage For="@(() => inventory.Name)" />
        </div>
        <div class="form-group">
            <label for="quantity">Quantity:</label>
            <InputNumber id="quantity" class="form-control" @bind-Value="inventory.Quantity" />
            <ValidationMessage For="@(() => inventory.Quantity)" />
        </div>
        <div class="form-group">
            <label for="price">Price:</label>
            <InputNumber id="price" class="form-control" @bind-Value="inventory.Price" />
            <ValidationMessage For="@(() => inventory.Price)" />
        </div>
        <div class="form-group">
            <br />
            <button type="submit" class="btn btn-primary">Update</button>
            &nbsp;
            <a href="/inventories" class="btn btn-secondary">Cancel</a>
        </div>
    </EditForm>
}
@code {
    [Parameter]
    public int InventoryId { get; set; }

    [SupplyParameterFromForm]
    private InventoryViewModel? inventory { get; set; } = null;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (inventory is null)
            {
                var invFromDb = await getUseCase.ExecuteAsync(InventoryId);
                inventory = new InventoryViewModel
                {
                    Id = invFromDb.Id,
                    Name = invFromDb.Name,
                    Quantity = invFromDb.Quantity,
                    Price = invFromDb.Price
                };
            }
        }
        catch (NotFoundException)
        {
            navManager.NotFound();
        }
    }
    private async Task Update()
    {
        await editUseCase.ExecuteAsync(new Inventory
        {
            Id = inventory!.Id,
            Name = inventory.Name,
            Quantity = inventory.Quantity,
            Price = inventory.Price
        });
        navManager.NavigateTo("/inventories");
    }
}