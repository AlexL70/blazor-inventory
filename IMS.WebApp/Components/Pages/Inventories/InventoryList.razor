@page "/inventories"
@attribute [Authorize]
@inject NavigationManager NavigationManager

<h3>Inventory List</h3>
<SearchComponent OnSearch="HandleSearch"></SearchComponent>
<InventoryListComponent SearchFilter="@inventorySearchFilter"></InventoryListComponent>
<br />
<a href="/inventories/add" class="btn btn-primary">Add Inventory</a>
<br />

@code {
    private string? inventorySearchFilter;

    private void HandleSearch(string? searchFilter)
    {
        inventorySearchFilter = searchFilter;
    }
}