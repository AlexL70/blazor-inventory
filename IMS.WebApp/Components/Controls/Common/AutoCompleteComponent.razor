<div class="form-group">
    <label for="search">@Label</label>
    <input type="text" class="form-control" id="search" placeholder="@Placeholder" @bind-value="@userInput"
        @bind-value:event="oninput" />
</div>
@if (searchResults?.Any() ?? false)
{
    <ul class="search-result">
        @foreach (var item in searchResults)
        {
            <li @key="item.Id">@item.Name</li>
        }
    </ul>
}

@code {
    [Parameter]
    public string Label { get; set; } = "Search";
    [Parameter]
    public string Placeholder { get; set; } = "Type to search...";
    [Parameter]
    public Func<string, List<ItemViewModel>>? SearchFunction { get; set; }
    private IList<ItemViewModel> searchResults = new List<ItemViewModel>();
    private string _userInput = string.Empty;
    public string userInput
    {
        get => _userInput;
        set
        {
            _userInput = value;
            if (SearchFunction != null)
            {
                searchResults = SearchFunction.Invoke(value);
            }
        }
    }

    public class ItemViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}