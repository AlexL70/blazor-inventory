<div class="form-group">
    <label for="search">@Label</label>
    <input type="text" class="form-control" id="search" placeholder="@Placeholder" @bind-value="@userInput"
        @bind-value:event="oninput" @onkeyup="OnKeyUp" />
</div>
@if (searchResults?.Any() ?? false)
{
    <ul class="search-result">
        @{
            var itemIndex = 0;
            foreach (var item in searchResults)
            {
                <li @key="item.Id" @onclick="() => HandleSelectItem(item)"
                    class="@(itemIndex == highlightedIndex ? "highlighted" : "")">@item.Name</li>
                itemIndex++;
            }
        }
    </ul>
}

@code {
    [Parameter]
    public string Label { get; set; } = "Search";
    [Parameter]
    public string Placeholder { get; set; } = "Type to search...";
    [Parameter]
    public Func<string, List<ItemViewModel>>? SearchFunction { get; set; }
    [Parameter]
    public EventCallback<ItemViewModel> OnItemSelected { get; set; }
    private IList<ItemViewModel> searchResults = new List<ItemViewModel>();
    private ItemViewModel? selectedItem;
    private ItemViewModel? highlightedItem;
    private int highlightedIndex = -1;
    private string _userInput = string.Empty;
    public string userInput
    {
        get => _userInput;
        set
        {
            _userInput = value;
            if (SearchFunction != null)
            {
                searchResults = SearchFunction.Invoke(value);
            }
        }
    }

    private void HandleSelectItem(ItemViewModel item)
    {
        // Clear selection
        highlightedItem = null;
        highlightedIndex = -1;
        // Set selected item
        selectedItem = item;
        userInput = item.Name;
        // Clear list
        searchResults = new List<ItemViewModel>();
        // Invoke callback
        OnItemSelected.InvokeAsync(item);
    }


    private void OnKeyUp(KeyboardEventArgs e)
    {
        // Handle only arrow up and down keys and only if there are search results
        if (searchResults?.Count > 0 && new[] { "ArrowDown", "ArrowUp" }.Contains(e.Key))
        {
            if (highlightedIndex < 0)
            {
                if (e.Key == "ArrowDown")
                {
                    highlightedItem = searchResults[0];
                    highlightedIndex = 0;
                }
                else if (e.Key == "ArrowUp")
                {
                    highlightedItem = searchResults[^1];
                    highlightedIndex = searchResults.Count - 1;
                }
            }
            else
            {
                if (e.Key == "ArrowDown")
                {
                    highlightedIndex = (highlightedIndex + 1) % searchResults.Count;
                    highlightedItem = searchResults[highlightedIndex];
                }
                else if (e.Key == "ArrowUp")
                {
                    highlightedIndex = (highlightedIndex - 1 + searchResults.Count) % searchResults.Count;
                    highlightedItem = searchResults[highlightedIndex];
                }
            }
        }
        else if ((e.Key == "Enter" || e.Key == "NumpadEnter") && highlightedItem != null)
        {
            HandleSelectItem(highlightedItem);
        }
    }

    public class ItemViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}