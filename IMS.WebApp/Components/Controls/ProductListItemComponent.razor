@inject IDeleteProductUseCase deleteUseCase;
@inject NavigationManager navManager;
@if (Product is not null)
{
    <tr>
        <td>@Product.Name</td>
        <td>@Product.Quantity</td>
        <td>@Product.Price.ToString("c")</td>
        <td>
            <a class="btn btn-light" href=@($"/products/edit/{Product.Id}")>Edit</a>
        </td>
        <td>
            <button type="button" class="btn btn-danger"
                @onclick="async () => { await DeleteProduct(Product.Id); }">Delete</button>
        </td>
    </tr>
}

@code {
    [Parameter]
    public Product? Product { get; set; } = null;

    private async Task DeleteProduct(int productId)
    {
        await deleteUseCase.ExecuteAsync(productId);
        this.Product = null;
    }
}