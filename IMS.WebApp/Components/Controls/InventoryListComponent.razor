@inject IViewInventoriesByNameUserCase view;

@if (inventories is null)
{
    <p><em>Loading...</em></p>
}
else if (inventories.Count == 0)
{
    <p><em>No inventories found.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Quantity</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Inventory inventory in inventories)
            {
                <InventoryListItemComponent Inventory="inventory"></InventoryListItemComponent>
            }
        </tbody>
    </table>
}

@code {
    private List<Inventory>? inventories;

    [Parameter]
    public string? SearchFilter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        inventories = (await view.ExecuteAsync(SearchFilter ?? string.Empty)).ToList();
        return;
    }
}