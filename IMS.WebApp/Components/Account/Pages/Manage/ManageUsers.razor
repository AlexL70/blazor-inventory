@page "/Account/UserManagement/List"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@layout IMS.WebApp.Components.Layout.MainLayout

@attribute [Authorize(Policy = Policies.Admin)]

@inject UserManager<ApplicationUser> userManager

<h3>Manage Users</h3>
<br />

@if (users is null)
{
    <p><em>Loading...</em></p>
}
else if (!users.Any())
{
    <p>No users found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th />
            </tr>
        <tbody>
            @foreach (var user in users!)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>
                        <a class="btn btn-link" href="@($"/account/manageuser/{user.Id}")">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
        </thead>
    </table>
}
@code {
    private IList<ApplicationUser>? users;

    protected override async Task OnInitializedAsync()
    {
        users = await userManager.Users.ToListAsync();
        await base.OnInitializedAsync();
    }
}