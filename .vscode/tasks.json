{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/IMS.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "clean",
      "type": "process",
      "command": "dotnet",
      "args": [ "clean", "${workspaceFolder}/IMS.sln" ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}